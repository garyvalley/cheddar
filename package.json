{
  "name": "cheddar",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "nuxt build",
    "setup": "node scripts/setup.mjs",
    "dev": "nuxt dev",
    "dev:stop": "docker compose down",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test:unit": "node --test 'tests/*.test.mjs'",
    "test:api": "node --env-file-if-exists=.env --test 'tests/api/*.test.mjs'",
    "test:ui": "node --env-file-if-exists=.env tests/ui.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "^4.6.0",
    "nuxt-security": "^2.7.0",
    "pocketbase": "^0.28.0",
    "uqr": "^0.1.3",
    "vue": "^3.5.43",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.8.0",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.8"
  }
}
