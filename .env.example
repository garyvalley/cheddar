# Dev ports, chosen not to clash with Homefile's (3001/8091).
NUXT_DEV_PORT=3005
PB_HOST_PORT=8095
NUXT_POCKETBASE_URL=http://127.0.0.1:8095

# Superuser for PocketBase's admin UI, migrations and the API suites.
# `pnpm run setup` fills these in (a random password) when they're empty.
PB_SU_EMAIL=
PB_SU_PASS=

# Mailjet, for address confirmation and password reset mail. Unset, mail is
# skipped and logged; read links from PocketBase's admin UI instead.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=
MAILJET_SENDER_NAME=Cheddar


# Bank linking through Plaid (pb_hooks/bank_links.pb.js). BANK_LINK_KEY is
# 32 characters that encrypt each link's access token; `pnpm run setup` makes
# one. PLAID_CLIENT_ID and PLAID_SECRET come from dashboard.plaid.com,
# Developers -> Keys (the Sandbox secret with PLAID_ENV=sandbox). Without all
# three, linking is off. PLAID_API_URL is for the API tests' stand-in only.
BANK_LINK_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_API_URL=
