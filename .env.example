# Dev ports, chosen not to clash with Homefile's (3001/8091).
NUXT_DEV_PORT=3005
PB_HOST_PORT=8095
NUXT_POCKETBASE_URL=http://127.0.0.1:8095

# Superuser for PocketBase's admin UI, migrations and the API suites.
# `pnpm run setup` fills these in (a random password) when they're empty.
PB_SU_EMAIL=
PB_SU_PASS=

# Mailjet, for address confirmation and password reset mail. Unset, mail is
# skipped and logged; read links from PocketBase's admin UI instead.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=
MAILJET_SENDER_NAME=Cheddar

# The header the rate limiter reads the client's address from. The API suite
# sends its own per test; the cluster uses cf-connecting-ip. Never set a
# header here that a client can forge on a deployed server.
NUXT_CLIENT_IP_HEADER=x-test-ip
