# The stock image, with Cheddar's config built in rather than mounted, so a
# config change changes the image and the deploy rolls the pod.
FROM public.ecr.aws/docker/library/nginx:1.30-alpine

# CI passes the commit as IMAGE_TAG: as an ARG it keys this layer's cache,
# so each build picks up Alpine's security updates.
ARG IMAGE_TAG
RUN apk upgrade --no-cache

COPY nginx/nginx.conf.template /etc/nginx/cheddar.conf.template
COPY nginx/snippets/ /etc/nginx/snippets/
COPY nginx/unavailable.html /usr/share/nginx/holding/unavailable.html
COPY nginx/start.sh /start.sh
# The stock site goes: a config that was never written fails the health
# check rather than serving nginx's welcome page. conf.d is written at start,
# so the nginx user owns it (the cluster mounts an emptyDir there).
RUN rm /etc/nginx/conf.d/default.conf && chown nginx:nginx /etc/nginx/conf.d
# Not root: no `user` directive, the pid in /tmp, and the temp files' cache
# its own (the cluster mounts emptyDirs over both).
RUN sed -i -e '/^user /d' -e 's#/run/nginx.pid#/tmp/nginx.pid#' /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /var/cache/nginx

USER nginx
EXPOSE 8080
CMD ["/start.sh"]
