# Docker's official images, from AWS's mirror of them (the same digests):
# Docker Hub's anonymous limit, shared by every build from the home
# connection, ran out mid-deploy.
FROM public.ecr.aws/docker/library/alpine:3.24

ARG PB_VERSION=0.40.6
# Set by BuildKit from the target platform: arm64 for the Raspberry Pi
# cluster, amd64 for CI's test and scan builds. PocketBase names its release
# archives the same way.
# No default: a default here overrides the value BuildKit supplies.
ARG TARGETARCH

# CI passes the commit as IMAGE_TAG: as an ARG it keys this layer's cache,
# so each build picks up Alpine's security updates.
ARG IMAGE_TAG
RUN apk upgrade --no-cache && apk add --no-cache \
    unzip \
    ca-certificates \
    curl

RUN curl -fsSL -o /tmp/pb.zip \
    "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_${TARGETARCH}.zip" \
    && unzip /tmp/pb.zip -d /pb/ \
    && rm /tmp/pb.zip \
    && chmod +x /pb/pocketbase

# Built in so that a deploy which changes only a hook still changes the
# image, and the new pod loads it on start. The dev and CI stacks mount the
# repo's copy over it. The schema is Nuxt's (scripts/migrate.mjs).
COPY pb_hooks /pb/pb_hooks
COPY scripts/pocketbase-start.sh /pb/start.sh

# Not root: the cluster mounts pb_data with this group (k8s/app/pocketbase.yaml).
RUN adduser -D -H -u 10001 pb && mkdir -p /pb/pb_data && chown -R pb:pb /pb/pb_data
USER 10001:10001

EXPOSE 8090

CMD ["/pb/start.sh"]
